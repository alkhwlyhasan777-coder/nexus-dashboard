/* Usable width (px) INSIDE the navbar card, which is the screen minus the sidebar and paddings.
   As the navbar gets narrower, things collapse in this order (largest number first). */
export const NAV_BREAKPOINTS = {
  wideSearch: 1080,   // below this the search box shrinks from 256px to 192px
  inlineLinks: 1000,  // below this the links move into the menu button
  userText: 720,      // below this only the avatar is shown (no name/role)
  inlineSearch: 580,  // below this the search box becomes an icon
  createLabel: 440,   // below this the Create button is icon-only
};